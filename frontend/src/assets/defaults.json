          "label": "Charge pondérée (kN/m)"
        }
      ]
    },
    "formules": {
      "Poutre simple - Charge Uniformement Distribuée": {
        "wd_l": "(cm + cv) * lt",
        "mf": "wl * (l * l) / 8",
        "mx": "wl * x * (l - x) / 2",
        "vf": "(wl * l) / 2",
        "vx": "wl * (l/2 - x)",
        "vd": "(wd_l * l) / 2",
        "I_240": "(5 * 1000 * cv * delta_1 * l**3 * lt) / (384 * e)",
        "I_360": "(5 * 1000 * cv * delta_2 * l**3 * lt) / (384 * e)",
        "I_480": "(5 * 1000 * cv * delta_3 * l**3 * lt) / (384 * e)",
        "I_alt": "(5 * 1000 * (cm + cv) * delta_1 * l**3 * lt) / (384 * e)",
        "i": "Max(I_240, I_360, I_480, I_alt)",
        "wl": "((cv * 1.5) + (cm * 1.25)) * lt"
      },
      "Poutre simple - Charge Uniforme au Centre": {
        "wl": "((cv * 1.5) + (cm * 1.25)) * lt",
        "wdl": "(cv + cm) * lt",
        "vf1": "wl * b * (2*c + b) / (2*l)",
        "vf2": "wl * b * (2*a + b) / (2*l)",
        "vf": "Max(vf1, vf2)",
        "vd": "wdl * b * Max(2*c + b, 2*a + b) / (2*l)",
        "mf": "vf1 * (a + vf1 / (2*wl))",
        "mx": "Piecewise((vf1*x, x <= a), (vf1*x - wl*(x-a)**2/2, x <= a+b), (vf2*(l-x), True))",
        "vx": "Piecewise((vf1, x <= a), (vf1-wl*(x-a), x <= a+b), (-vf2, True))"
      }
    }
  },
  "config": {
